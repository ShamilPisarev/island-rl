.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

checkpoints/
runs/

# Replays and their manifest are generated. Committing them would leave a fresh
# clone with an index.json pointing at files it does not have; run
# `python -m sim.make_fake_replay` to get something to look at.
viewer/replays/*
!viewer/replays/.gitkeep
viewer/reports/*
!viewer/reports/.gitkeep

.DS_Store
